# Public base URL of the deployed site (used for metadata, sitemap, payment return URLs)
# Production (set in Vercel): https://www.newsagarikadrivingschool.lk
# Local dev (.env.local): http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.newsagarikadrivingschool.lk

# --- PayHere (Sri Lanka) ---
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# sandbox | live
PAYHERE_MODE=sandbox

